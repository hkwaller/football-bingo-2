{
  "name": "football-bingo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "verify:data": "tsx scripts/verify-categories.ts",
    "enrich": "tsx scripts/enrichPlayers.ts",
    "enrich:refresh": "tsx scripts/enrichPlayers.ts --refresh",
    "parse": "tsx scripts/parsePlayers.ts",
    "wiki:career": "tsx scripts/fetchWikiCareerStats.ts",
    "write-players": "tsx scripts/writePlayers.ts",
    "write-derived": "tsx scripts/writeDerivedPlayerData.ts",
    "fetch-logos": "tsx scripts/fetchLogos.ts",
    "tenable:index": "tsx scripts/buildTenableIndex.ts",
    "tenable:verify": "tsx scripts/verifyTenable.ts",
    "tenable:images": "tsx scripts/fetchTenableWikiImages.ts",
    "tenable:open": "tsx scripts/buildTenableOpenSets.ts && tsx scripts/verifyTenable.ts",
    "famous11s:verify": "tsx scripts/verifyFamous11s.ts",
    "careers:fetch": "tsx scripts/fetchCareerTransfers.ts",
    "careers:build": "tsx scripts/buildCareers.ts",
    "native:sync": "cap sync",
    "native:dev": "CAP_SERVER_URL=${CAP_SERVER_URL:-http://localhost:3000} cap sync",
    "native:icons": "node scripts/native/icons.mjs && capacitor-assets generate --ios --android --assetPath native/assets --iconBackgroundColor '#0E4A2C' --iconBackgroundColorDark '#0E4A2C' --splashBackgroundColor '#0E4A2C' --splashBackgroundColorDark '#0E4A2C'",
    "native:ios": "cap open ios",
    "native:android": "cap open android",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@clerk/nextjs": "^6.39.7",
    "@liveblocks/client": "^2.18.0",
    "@liveblocks/node": "^2.18.0",
    "@liveblocks/react": "^2.18.0",
    "@supabase/supabase-js": "^2.49.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.0",
    "lucide-react": "^1.25.0",
    "next": "^16.3.6",
    "posthog-js": "^1.435.3",
    "qrcode.react": "^4.2.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "shadcn": "^4.2.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
